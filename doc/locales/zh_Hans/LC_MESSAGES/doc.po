#: ../references/security.rst:22 134770866f41416fb912bc9f24307ab5
msgid "ID"
msgstr ""

#: ../references/security.rst:23 719690c59e294dffbcc6145baa616914
msgid "ANSSI Recommendation"
msgstr ""

#: ../references/security.rst:24 008240b7573e420c91799c30350e8115
msgid "Canaille implementation"
msgstr ""

#: ../references/security.rst:25 53c618bde0dc4279b9b70e2bc266e92e
msgid "Status"
msgstr ""

#: ../references/security.rst:26 4a09b2e7ad9545c49391cb6c3a14af5d
msgid "R1"
msgstr ""

#: ../references/security.rst:27 b8e424bfa55c4e90abc1c956b0810b28
msgid ""
"Favor multi-factor authentication. Use multiple authentication factors from "
"different categories (knowledge, possession, inherence)."
msgstr ""

#: ../references/security.rst:28 6c676a0085af46878e1b79823e4b3ffd
msgid "Canaille supports :ref:`multi-factor authentication <feature_mfa>`."
msgstr ""

#: ../references/security.rst:30 220b6e17dd1a4c7fa61f8b7460971a66
msgid "R2"
msgstr ""

#: ../references/security.rst:31 87b1a0ce74c04402ad454f4b05e50d30
msgid ""
"Favor the use of strong authentication methods. Use cryptographic mechanisms "
"compliant with `RGS <https://cyber.gouv.fr/le-referentiel-general-de-"
"securite-rgs>`__ and its annexes."
msgstr ""

#: ../references/security.rst:32 9e9d2a018d1a45cd84694406759e697f
msgid ""
"Canaille implements :ref:`TOTP <feature_mfa>` and :ref:`FIDO2/WebAuthn "
"<feature_mfa>` which use strong cryptographic mechanisms."
msgstr ""

#: ../references/security.rst:34 54d03d0de297454d8aca7e76da8a235f
msgid "R3"
msgstr ""

#: ../references/security.rst:35 9b468a678ee746d7a38323de293a232f
msgid ""
"Conduct a risk analysis. Perform risk analysis to determine appropriate "
"authentication methods based on security needs."
msgstr ""

#: ../references/security.rst:36 8800d10c73d04f6a9e74231fcc88af8d
msgid ""
"This is an organizational responsibility, not specific to Canaille "
"implementation."
msgstr ""

#: ../references/security.rst:37 ../references/security.rst:41
#: ../references/security.rst:49 ../references/security.rst:71
#: ../references/security.rst:94 ../references/security.rst:98
#: ../references/security.rst:106 ../references/security.rst:138
#: ../references/security.rst:167 ../references/security.rst:171
#: ../references/security.rst:195 d136b569ee604504b52192befc96cb15
#: b34ac7d293df4434a2f8b73ebf766e54 556572ea3a8e4968bcf652778306968c
#: 8dfcf545f3b448d9aef18f1d4f75e239 f594debdee9a4192aa9dd0fe480fcefa
#: 043e05a762df4b6488562b53aaf1de34 5a56f06de75f4c02b49e4d2369042d33
#: 66d0b67de71f45919d5fa0abc0aa228a d2b1b9c154e8461bb4b1b574d2c56fd0
#: 9b74393cbf6045b8b3e500d9a6ab5da5 e8dc06cb82e749fcb218f0f1f5da2363
msgid "⬜"
msgstr ""

#: ../references/security.rst:38 1044ace2854446dea5adca6250d5c73b
msgid "R4"
msgstr ""

#: ../references/security.rst:39 d754850ddb6b4c5aa95e6d11f259c377
msgid ""
"Create authentication factors in a controlled environment. Create and "
"deliver factors in a secure environment consistent with the expected "
"security level."
msgstr ""

#: ../references/security.rst:40 d60571d121c84ac7801c8be17cce3635
msgid "This is an organizational and operational responsibility."
msgstr ""

#: ../references/security.rst:42 6f9136d372f747c78915d7d59ef4d2d7
msgid "R5"
msgstr ""

#: ../references/security.rst:43 56fd2a2764a441e587b65eb3f34296bf
msgid ""
"Generate random elements with a robust generator. Use a random number "
"generator compliant with `RGS <https://cyber.gouv.fr/le-referentiel-general-"
"de-securite-rgs>`__ annex B1."
msgstr ""

#: ../references/security.rst:44 36c0ed0890c24e1d87ab68447a6d4c74
msgid ""
"Canaille uses :mod:`Python's cryptographically secure random generators "
"<secrets>`."
msgstr ""

#: ../references/security.rst:46 0721084888b449f38e98fd63d693536b
msgid "R6"
msgstr ""

#: ../references/security.rst:47 d9ecbb4c6c624fceab615f691e78eed0
msgid ""
"Deliver authentication factors through secure channels. Favor hand delivery "
"or use channels protected for integrity, authenticity and confidentiality."
msgstr ""

#: ../references/security.rst:48 1272fd41de9641d78a85c01f88fb4062
msgid "This is an organizational responsibility for credential distribution."
msgstr ""

#: ../references/security.rst:50 0fc1660debdf4fc3b84a1d2b0c250a7b
msgid "R7"
msgstr ""

#: ../references/security.rst:51 1b6f52d8ba454d7297baac6b4f9955dc
msgid ""
"Implement an authentication factor renewal process. Allow users to renew "
"their authentication factors."
msgstr ""

#: ../references/security.rst:52 4acb84cbc8ab428887e7b343cd306401
msgid ""
"Users can update their password, email address and phone numbers. The can "
"manage their :ref:`TOTP <feature_mfa>` devices in their profile."
msgstr ""

#: ../references/security.rst:54 fa4e7212aa764f13880df1d71949345c
msgid "R8"
msgstr ""

#: ../references/security.rst:55 14a9dd45b3aa4b8284d2480d7dab0d07
msgid "Do not use SMS as a means of receiving an authentication factor."
msgstr ""

#: ../references/security.rst:56 5da75e714bf241c5a7f801aae9a13aa2
msgid ""
"SMS authentication is available in Canaille, but disabled by default. It is "
"still offered as a convenient alternative in low-security contexts."
msgstr ""

#: ../references/security.rst:59 2d4afb852960492fbd23317fbaf5e1ee
msgid "R9"
msgstr ""

#: ../references/security.rst:60 3ab62a3035a54361a9579f5e1a57f88b
msgid ""
"Preserve usage history of authentication factors. Log authentication-related "
"events to detect abnormal behavior."
msgstr ""

#: ../references/security.rst:61 33d290c307af493d8c0c022d1c352737
msgid "Canaille logs authentication events and login attempts."
msgstr ""

#: ../references/security.rst:63 c3594543c3584ebdbb2df6527599e1f6
msgid "R10"
msgstr ""

#: ../references/security.rst:64 aa708b4d71ca4a3c8683891dfed4f09f
msgid "Limit authentication attempts over time."
msgstr ""

#: ../references/security.rst:65 c54b6a73a206493a83caab15dd60df98
msgid ""
"Canaille implements :ref:`intruder lockout <feature_intruder_lockout>` with "
"progressive delays after failed attempts. "
"See :attr:`~canaille.core.configuration.CoreSettings.ENABLE_INTRUDER_LOCKOUT`."
msgstr ""

#: ../references/security.rst:68 d5f2574f9894470eb9f3a3716cb15ccd
msgid "R11"
msgstr ""

#: ../references/security.rst:69 841e2a6b0f3a4fe589dc73b0531c24d2
msgid ""
"Perform authentication through a secure channel. Use protocols like TLS or "
"IPsec to protect authentication communications."
msgstr ""

#: ../references/security.rst:70 382bc646dbab405ab20e31fc9f694781
msgid "This is handled by the web server configuration."
msgstr ""

#: ../references/security.rst:72 414abf032ed64f0fb0621fdee1e926a6
msgid "R12"
msgstr ""

#: ../references/security.rst:73 f646376e73544bb9a9ad5c9ef7ced0bb
msgid ""
"Limit the validity duration of authenticated sessions. Set maximum session "
"duration and force periodic re-authentication."
msgstr ""

#: ../references/security.rst:74 1b66221478094ae79789a65693fcb550
msgid ""
"Canaille limits session duration. The default value of 1 year is "
"customizable. "
"See :attr:`~canaille.app.configuration.RootSettings.PERMANENT_SESSION_LIFETIME`."
msgstr ""

#: ../references/security.rst:76 615caeb14cba48f5bc9d76bf2adbabe5
msgid "R13"
msgstr ""

#: ../references/security.rst:77 9e1b793c780c40779d888629ae72b2f1
msgid ""
"Protect authentication data stored by the verifier. Ensure confidentiality "
"and integrity protection of stored authentication data."
msgstr ""

#: ../references/security.rst:78 9fa2fbed83844a668d0d86766c676854
msgid ""
"Canaille properly hashes passwords using secure algorithms. "
"See :attr:`~canaille.backends.sql.configuration.SQLSettings.PASSWORD_SCHEMES`."
msgstr ""

#: ../references/security.rst:80 f26bc74e543a460bb15271bc867eb57a
msgid "R14"
msgstr ""

#: ../references/security.rst:81 2ac29f2f5aec42a4897645dca16f6ece
msgid ""
"Do not provide information about authentication failure. In case of multi-"
"factor failure, do not reveal which factor caused the failure."
msgstr ""

#: ../references/security.rst:82 e63b97ee546448cd91f21e603a6049e6
msgid "Canaille verifies each factor one by one."
msgstr ""

#: ../references/security.rst:84 f8226837c8e84c248f30de34da235ae8
msgid "R15"
msgstr ""

#: ../references/security.rst:85 2541b6443e504dae9a87bd6f9fdd006d
msgid ""
"Define expiration delays for authentication factors. Set expiration dates to "
"limit fraudulent use."
msgstr ""

#: ../references/security.rst:86 b41f0ae4e1a94a1b8a2c54663a7e3bb1
msgid ""
"Canaille implements expiration for email and SMS codes, as well as TOTP. "
"HOTP codes don't expire, but they are not used by default when selecting OTP "
"authentication factor. Password can have an expiration date, but this not "
"recommended for common user accounts by R24. "
"See :attr:`~canaille.core.configuration.CoreSettings.OTP_LIFETIME`, :attr:`~canaille.core.configuration.CoreSettings.TOTP_LIFETIME` "
"and :attr:`~canaille.core.configuration.CoreSettings.PASSWORD_LIFETIME`."
msgstr ""

#: ../references/security.rst:91 fb1be49281b744b39063c6497cd41197
msgid "R16"
msgstr ""

#: ../references/security.rst:92 b0e66c124537483295c0dc455798e45c
msgid ""
"Define a usage policy for authentication factors. Establish usage conditions "
"and procedures for loss or compromise cases."
msgstr ""

#: ../references/security.rst:93 20f123a98c2d45a0b2af4218c7bac93f
msgid "This is an organizational policy responsibility."
msgstr ""

#: ../references/security.rst:95 025a513b4a434a30aaf0daf712c19f77
msgid "R17"
msgstr ""

#: ../references/security.rst:96 f32f041dccc24a7fae73a2636ad4a341
msgid ""
"Raise user awareness about authentication security. Implement awareness "
"campaigns about risks (phishing, etc.)."
msgstr ""

#: ../references/security.rst:97 b3ddcf2f93154cc2b403891701cfa9e0
msgid "This is an organizational training responsibility."
msgstr ""

#: ../references/security.rst:99 f9fc45c11ff84cc28be271b9e32da594
msgid "R18"
msgstr ""

#: ../references/security.rst:100 733eba5584544ae0b672b75c7252c9d7
msgid "Enable factor revocation and distribute revocation information."
msgstr ""

#: ../references/security.rst:101 40627f4890b6497c91fd613e5a74c5fb
msgid ""
"All the authentication factors can be reset, but the way by which users ask "
"for a revokation is the responsibility of the organization."
msgstr ""

#: ../references/security.rst:103 e9dec51881494988aaead5a187d4c7e9
msgid "R19"
msgstr ""

#: ../references/security.rst:104 3d547dc871a648daa8ae6dfaaf721e5b
msgid ""
"Define appropriate revocation processing delays. Adapt revocation delays to "
"threats facing the system."
msgstr ""

#: ../references/security.rst:105 4c5a88d960ed45a3908d8c5ac562ffd9
msgid "This is an organizational policy decision."
msgstr ""

#: ../references/security.rst:107 4f4116ece4cf4dcdb087c8112600718b
msgid "R20"
msgstr ""

#: ../references/security.rst:108 d445055e171b49cd8d3525644218c95f
msgid ""
"Implement a password security policy. Define a policy adapted to context and "
"security objectives."
msgstr ""

#: ../references/security.rst:109 88289fedb0664d36828d9bcad5dadfdb
msgid ""
"The formal definition of the security is the responsibility of the "
"organization, but any part of the policy can be customized in Canaille. See "
"following recommendations. Canaille provides good-enough defaults for all "
"the points."
msgstr ""

#: ../references/security.rst:111 c226d3a880b0465b9fc03fbda00d9b25
msgid "R21"
msgstr ""

#: ../references/security.rst:112 30ea9f74b556450781fae5bf88f6083b
msgid ""
"Enforce minimum password length. Define minimum length based on target "
"security level."
msgstr ""

#: ../references/security.rst:113 4ed1e041cfa940298fd075abc61cce48
msgid ""
"Password length is configurable. "
"See :attr:`~canaille.core.configuration.CoreSettings.MIN_PASSWORD_LENGTH` "
"setting."
msgstr ""

#: ../references/security.rst:115 aab079bbecda410c9306853a12871d5e
msgid "R22"
msgstr ""

#: ../references/security.rst:116 5a27fdd47288456fba05ebbcb7e67f52
msgid ""
"Do not enforce maximum password length. Allow the use of long passphrases."
msgstr ""

#: ../references/security.rst:117 f8423d9c4bae465ba2c4ef206792f96f
msgid ""
"Canaille supports long passwords, but sets a great-enough upper limit to "
"prevent DOS attacks by providing too heavy payloads. "
"See :attr:`~canaille.core.configuration.CoreSettings.MAX_PASSWORD_LENGTH`."
msgstr ""

#: ../references/security.rst:120 f3bff5491a7047ddaf01294067b8502c
msgid "R23"
msgstr ""

#: ../references/security.rst:121 17d665c78b364b23b2ba3b3f2d93e588
msgid ""
"Implement password complexity rules. Impose constraints on character types "
"used."
msgstr ""

#: ../references/security.rst:122 ffe92e2bdcee4fd290da770d6c97cb2a
msgid ""
"Canaille does not enforce character type complexity requirements. See "
"the :issue:`related issue <297>`."
msgstr ""

#: ../references/security.rst:124 dbdee40037794dfdb3082293b5b32e49
msgid "R24"
msgstr ""

#: ../references/security.rst:125 9cd383be692c4f97ba3e58792f16d14c
msgid ""
"Do not enforce expiration delays by default on non-sensitive accounts. Avoid "
"automatic expiration for standard user accounts if passwords are robust."
msgstr ""

#: ../references/security.rst:127 b131b7a9460542a48b187246f0fda4f4
msgid "Canaille does not enforce password expiration by default."
msgstr ""

#: ../references/security.rst:129 95d7ee751de8406780f259e63d568d93
msgid "R25"
msgstr ""

#: ../references/security.rst:130 e32a6f5e4bcb4da19b985d25a420d987
msgid ""
"Enforce expiration delays on privileged account passwords. Set expiration "
"(1-3 years) for administrator accounts."
msgstr ""

#: ../references/security.rst:132 71eac1e7b75644f38bf1f57355e35e3c
msgid ""
"Password expiration :attr:`can be customized "
"<canaille.core.configuration.CoreSettings.MAX_PASSWORD_LENGTH>` but Canaille "
"does not differentiate password policies between regular and privileged "
"accounts."
msgstr ""

#: ../references/security.rst:133 ../references/security.rst:144
#: 1da43efa5b3642b6bab9a51aa3242d26 33e93cd78aba454995e79eb28b254026
msgid "🟧"
msgstr ""

#: ../references/security.rst:134 2320f0e919344eb2a910e8d57d82fbec
msgid "R26"
msgstr ""

#: ../references/security.rst:135 e7b4564f62954d44b8f3bfd7fc5b9ced
msgid ""
"Immediately revoke passwords in case of suspected or confirmed compromise. "
"Renew all affected passwords within a day in case of incident."
msgstr ""

#: ../references/security.rst:137 eaba47261bcb459c9710fc5d91ce1836
msgid "This is an operational incident response procedure."
msgstr ""

#: ../references/security.rst:139 e2d3f17de69248f6bd0c78d970af63f7
msgid "R27"
msgstr ""

#: ../references/security.rst:140 e3189b18a9f44b3ab4e9d17ed26cb54f
msgid ""
"Implement password strength control. Automatically check strength during "
"creation/renewal."
msgstr ""

#: ../references/security.rst:141 ebfe70cd057f46f7bbbb2a8daa07bc92
msgid ""
"Canaille implements password strength validation using the zxcvbn algorithm, "
"with a visual strength indicator during password entry. Additionally, "
"passwords are tested against the `Have I Been Pwned <https://"
"haveibeenpwned.com>`__ database. However, Canaille don't look for reuse of "
"old passwords, or :issue:`personal information in the current password "
"<298>`."
msgstr ""

#: ../references/security.rst:145 61dc8628b09d44e6aa2e5943fbe31c97
msgid "R28"
msgstr ""

#: ../references/security.rst:146 2c2a9126c01e462d8e7b9f923f058500
msgid ""
"Use a long random salt. Use a random salt of at least 128 bits for each "
"account."
msgstr ""

#: ../references/security.rst:147 e0ea3ee26156410787d9c655322f3f9b
msgid ""
"Canaille uses proper salting for password hashing with all "
"supported :attr:`~canaille.backends.sql.configuration.SQLSettings.PASSWORD_SCHEMES`."
msgstr ""

#: ../references/security.rst:149 dbc10b598cdc4956ad2b4c9d53b3ea91
msgid "R29"
msgstr ""

#: ../references/security.rst:150 5bc897c7b83e410e855525646dec787a
msgid ""
"Use memory-hard password derivation function to store passwords. Use scrypt "
"or Argon2 for password storage."
msgstr ""

#: ../references/security.rst:151 c1ae8c9195ab4da0ae1adc5c40f18e6a
msgid ""
"Canaille supports Argon2 and other secure algorithms "
"via :attr:`~canaille.backends.sql.configuration.SQLSettings.PASSWORD_SCHEMES`."
msgstr ""

#: ../references/security.rst:153 854bd8482cc544969ccb61b5acf2845d
msgid "R29-"
msgstr ""

#: ../references/security.rst:154 a2674ad75a604d44b1b6306482f51d1b
msgid ""
"Use iterative password derivation function to store passwords. Alternative: "
"use PBKDF2 if memory-hard functions are difficult to implement."
msgstr ""

#: ../references/security.rst:155 a704d1b1972747d494aca8f470b1ff87
msgid ""
"Canaille supports PBKDF2 and uses the ``pbkdf2_sha512`` scheme by default. "
"See :attr:`~canaille.backends.sql.configuration.SQLSettings.PASSWORD_SCHEMES`."
msgstr ""

#: ../references/security.rst:158 90f974b703914720a24aeeb39a537310
msgid "R30"
msgstr ""

#: ../references/security.rst:159 eb0d8776ad1e473b8638ca74c0518244
msgid ""
"Provide an access recovery method. Implement recovery procedures for "
"forgotten/lost credentials."
msgstr ""

#: ../references/security.rst:160 54dfb3dff0e04ed6939e7ce56979c61d
msgid ""
"Canaille can provide password recovery via email by configuration. Defining "
"the password recovery policy is the responsibility of the organization. "
"See :attr:`~canaille.core.configuration.CoreSettings.ENABLE_PASSWORD_RECOVERY`."
msgstr ""

#: ../references/security.rst:164 53649a10ac2e4b9285d07d062d6ea1ea
msgid "R31"
msgstr ""

#: ../references/security.rst:165 f0396566dc1b46b39f2554004d448669
msgid ""
"Provide a password vault. Supply and train users on password manager usage."
msgstr ""

#: ../references/security.rst:166 2c4cd3ca59144ff6a511bdb385f4ceec
msgid "This is an organizational responsibility to provide password managers."
msgstr ""

#: ../references/security.rst:168 90f92790fe7a403e9686374eb9b47e84
msgid "R32-R38"
msgstr ""

#: ../references/security.rst:170 a0ab65e6927a44e28ccd1543845dc15f
msgid "The recommendations R32 to R38 target end-users."
msgstr ""

#: ../references/security.rst:172 df1ea7be2c6948d5a2e813cadc007228
msgid "R39"
msgstr ""

#: ../references/security.rst:173 0ae713104ae244098b1cdc7783fa4d78
msgid ""
"Use a possession factor integrating a qualified security component. Favor "
"components that have received ANSSI security approval."
msgstr ""

#: ../references/security.rst:174 fca978b680bc4fe9bb4d9df77e96006b
msgid ""
":ref:`FIDO2/WebAuthn <feature_mfa>` supports hardware security keys with "
"integrated security components (e.g., YubiKey, Titan)."
msgstr ""

#: ../references/security.rst:176 37598239d8ce43a7bca5412415e18331
msgid "R39-"
msgstr ""

#: ../references/security.rst:177 a15b361304394516b7be96305b1f5689
msgid ""
"Use a possession factor integrating a security component. Alternative: use "
"at minimum an integrated security component."
msgstr ""

#: ../references/security.rst:178 1df936a35c6e4a05b0e87578a40dbbad
msgid ""
":ref:`FIDO2/WebAuthn <feature_mfa>` supports both hardware keys and platform "
"authenticators with security components."
msgstr ""

#: ../references/security.rst:180 04850847d1a440cda9a0dcc3186cc62c
msgid "R39--"
msgstr ""

#: ../references/security.rst:181 b9de7263ce5241d6b51b5edd76bd17cf
msgid ""
"Use a possession factor even without security component. As last resort, use "
"additional protection measures (encryption, access restrictions)."
msgstr ""

#: ../references/security.rst:182 172e6407d0e1426196ec0c56d017d24a
msgid ""
":ref:`TOTP <feature_mfa>` can work with software authenticators as a "
"possession factor "
"via :attr:`~canaille.core.configuration.CoreSettings.OTP_METHOD`."
msgstr ""

#: ../references/security.rst:184 daeb154688a44f48892228803827c890
msgid "R40"
msgstr ""

#: ../references/security.rst:185 2d80ed63067f4ec89376652551d538d6
msgid ""
"Do not use an inherent factor as sole authentication factor. Avoid "
"biometrics alone for authentication."
msgstr ""

#: ../references/security.rst:186 136c42d1b3c146158685696ccea7c323
msgid ""
":ref:`FIDO2/WebAuthn <feature_mfa>` can use biometric authenticators "
"(TouchID, FaceID, Windows Hello) combined with cryptographic proof-of-"
"possession."
msgstr ""

#: ../references/security.rst:188 98ec7745a009402db06dd1c411f77718
msgid "R41"
msgstr ""

#: ../references/security.rst:189 05ab760ea4b64c15ab70b50201be064a
msgid ""
"Use an inherent factor only associated with a strong factor. In multi-"
"factor, accompany biometrics with a cryptographic factor compliant with `RGS "
"<https://cyber.gouv.fr/le-referentiel-general-de-securite-rgs>`__."
msgstr ""

#: ../references/security.rst:190 919190641b5e41f796c7d039f0567a6f
msgid ""
":ref:`FIDO2/WebAuthn <feature_mfa>` implements cryptographic challenge-"
"response, satisfying this requirement when biometric user verification is "
"enabled."
msgstr ""

#: ../references/security.rst:192 76956e921d1449d3893090171fe3daca
msgid "R42"
msgstr ""

#: ../references/security.rst:193 2d08de39b7c84257a5a089abf1cf39cc
msgid ""
"Favor in-person meeting when registering an inherent factor. Perform face-to-"
"face identity verification for biometric enrollment."
msgstr ""

#: ../references/security.rst:194 0ecf2319bb1648e8bb4f5641b21b4121
msgid "This is an organizational enrollment procedure responsibility."
msgstr ""

