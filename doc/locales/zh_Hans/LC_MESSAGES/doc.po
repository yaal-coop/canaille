#: ../../CHANGES.rst:156 98dbc2dea7bf4a44ae6d336d2b4f7845
msgid ""
"With SQL databases, searching the members of a group also listed users who "
"were not members."
msgstr ""

#: ../../CHANGES.rst:158 08801c6a8ba14a7186f80780e1675c67
msgid ""
