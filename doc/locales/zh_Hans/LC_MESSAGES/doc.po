#: ../references/configuration.rst:10 fdbd9b17a1534cb0b86665f12d35604d
msgid "Configuration file"
msgstr ""

#: ../references/configuration.rst:14 34d4a9a38ed24c05ab3ab93fea98acb9
msgid ""
"The configuration can be written in `toml` configuration file which path is "
"passed in the :envvar:`CANAILLE_CONFIG` environment variable."
msgstr ""

