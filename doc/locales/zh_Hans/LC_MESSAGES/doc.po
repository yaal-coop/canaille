#: ../references/security.rst:16 1731f359c93e4b7f95f2e1aedb571c84
msgid ""
"⬜ Not relevant for Canaille (organizational/user/infrastructure "
"responsibility)"
msgstr ""

#: ../references/security.rst:18 bac263a40fe74919b7cf193640bee0a3
msgid "ANSSI authentication recommendations implementation status"
